{
  "version": 1,
  "fields": [
    {
      "id": "ticket_key",
      "label": "Ticket number",
      "type": "text",
      "required": true,
      "order": 10,
      "default": "",
      "placeholder": "PROJ-123",
      "validation": {
        "max_length": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "show_in_list": true,
      "show_in_compact": true,
      "list_width": "120px"
    },
    {
      "id": "title",
      "label": "Description",
      "type": "text",
      "required": false,
      "order": 20,
      "default": "",
      "show_in_list": true
    },
    {
      "id": "priority",
      "label": "Priority",
      "type": "number",
      "required": true,
      "order": "30a",
      "default": 5,
      "validation": {
        "step": 1
      },
      "show_in_list": true,
      "width_weight": 1
    },
    {
      "id": "urgency",
      "label": "Urgency",
      "type": "number",
      "required": false,
      "order": "30b",
      "default": 5,
      "validation": {
        "step": 1
      },
      "show_in_list": true,
      "width_weight": 1
    },
    {
      "id": "state",
      "label": "State",
      "type": "select",
      "required": true,
      "order": "30c",
      "default": "Submitted",
      "options": [
        "In fixing",
        "Submitted",
        "External Fixing \u2013 Support",
        "External Fixing \u2013 PS",
        "In QA",
        "Done",
        "On Hold"
      ],
      "show_in_list": true,
      "filterable": true,
      "width_weight": 2
    },
    {
      "id": "dn_assigned_to",
      "label": "DN Assigned To",
      "type": "text",
      "required": false,
      "order": "40a",
      "default": "",
      "filterable": true,
      "show_in_list": true
    },
    {
      "id": "customer_assigned_to",
      "label": "Customer Assigned To",
      "type": "text",
      "required": false,
      "order": "40b",
      "default": "",
      "filterable": true
    },
    {
      "id": "waiting",
      "label": "Waiting for...",
      "type": "checkbox",
      "required": false,
      "order": "49",
      "default": false,
      "visible_when": {
        "field": "state",
        "not_equals": "Done"
      },
      "filterable": true,
      "show_in_list": false
    },
    {
      "id": "waiting_for",
      "label": "Name",
      "type": "select",
      "required": false,
      "order": "50a",
      "default": "",
      "options": [],
      "visible_when": {
        "field": "waiting",
        "equals": true
      },
      "filterable": true,
      "show_in_list": true,
      "list_label": "Waiting For"
    },
    {
      "id": "waiting_for_reason",
      "label": "Waiting For Reason",
      "type": "textarea",
      "required": false,
      "order": "50b",
      "default": "",
      "visible_when": {
        "field": "waiting",
        "equals": true
      },
      "width_weight": 2
    },
    {
      "id": "waiting_since",
      "label": "Since",
      "type": "date",
      "required": false,
      "order": 51,
      "default": "",
      "visible_when": {
        "field": "waiting",
        "equals": true
      },
      "show_in_list": false
    },
    {
      "id": "notes",
      "label": "Notes",
      "type": "richtext",
      "required": false,
      "order": 60,
      "default": {
        "type": "doc",
        "content": []
      }
    }
  ],
  "system_fields": {
    "waiting_entered_at": {
      "computed": true,
      "source": "waiting_periods"
    },
    "waiting_duration_live": {
      "computed": true,
      "client_timer": true
    },
    "waiting_total_seconds": {
      "computed": true,
      "source": "waiting_periods"
    },
    "waiting_history": {
      "computed": true,
      "source": "waiting_periods"
    }
  }
}
