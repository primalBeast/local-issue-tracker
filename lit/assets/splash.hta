<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>Local Issue Tracker Starting</title>
<HTA:APPLICATION
  ID="LitSplash"
  APPLICATIONNAME="Local Issue Tracker Starting"
  BORDER="none"
  CAPTION="no"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="no"
  SCROLL="no"
  ICON="app.ico"
/>
<style>
  html, body {
    margin: 0;
    padding: 0;
    background: #0b0d12;
    overflow: hidden;
    font-family: "Segoe UI", sans-serif;
  }
  img {
    display: block;
    width: 720px;
    height: 378px;
    object-fit: cover;
  }
  .bar {
    height: 52px;
    background: #12151c;
    color: #e8eaed;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
    box-sizing: border-box;
  }
  .bar strong { font-size: 16px; }
  .bar span { color: #6ea8fe; font-size: 14px; }
</style>
<script language="javascript">
var elapsed = 0;
function place() {
  var w = 720, h = 430;
  window.resizeTo(w, h);
  window.moveTo(
    Math.max(0, (screen.availWidth - w) / 2),
    Math.max(0, (screen.availHeight - h) / 2)
  );
}
function closeIfSignaled() {
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var marker = fso.GetSpecialFolder(2) + "\\lit-splash.close";
    if (fso.FileExists(marker)) {
      try { fso.DeleteFile(marker, true); } catch (e) {}
      window.close();
      return;
    }
  } catch (e) {}
  elapsed += 200;
  if (elapsed >= 90000) window.close();
}
window.onload = function () {
  place();
  setInterval(closeIfSignaled, 200);
};
</script>
</head>
<body>
  <img src="splash.png" alt="">
  <div class="bar"><strong>Local Issue Tracker</strong><span>Starting...</span></div>
</body>
</html>
